# Include inside nginx's http context. Render with scripts/render-nginx.py.
# This topology expects nginx directly on the public edge, without another CDN.
map $uri $keyoxide_rate_key {
    /healthz "";
    default $binary_remote_addr;
}
limit_req_zone $keyoxide_rate_key zone=keyoxide_requests:10m rate=5r/s;
upstream keyoxide_candidate {
    server __UPSTREAM__;
    keepalive 16;
}
server {
    listen __BIND____HTTP_PORT__;
    server_name __DOMAIN__;
    return 308 https://__DOMAIN__$request_uri;
}
server {
    listen __BIND____HTTPS_PORT__ ssl;
    server_name __DOMAIN__;
    ssl_certificate __CERTIFICATE__;
    ssl_certificate_key __PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 30s;
    # Do not retain profile identifiers, query URLs, or verification requests.
    access_log off;
    error_log /dev/stderr crit;
    limit_req_status 429;
    location / {
        limit_req zone=keyoxide_requests burst=40 nodelay;
        proxy_pass http://keyoxide_candidate;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host __DOMAIN__;
        # Overwrite, never append untrusted client forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host __DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_max_temp_file_size 0;
    }
}
